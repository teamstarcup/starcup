cmd-variantizeallmaps-desc = Runs variantize on every grid of every map under Resources/Maps and saves the results to the bin data directory.
cmd-variantizeallmaps-help = variantizeallmaps [path filter]
cmd-variantizeallmaps-hint-filter = Only process maps whose path contains this
cmd-variantizeallmaps-none = No maps matched "{ $filter }".
cmd-variantizeallmaps-load-failed = Failed to load { $path }, skipping.
cmd-variantizeallmaps-save-failed = Failed to save { $path } (category { $category }).
cmd-variantizeallmaps-saved = { $path } ({ $grids } grid(s))
cmd-variantizeallmaps-done = Done: { $saved } saved, { $failed } failed.